# books stack — copy to .env (chmod 600) on ciri.
# No secrets: Kavita's admin account is created in the web UI on first run.
# The file exists only to keep the service account explicit and overridable,
# and so `docker compose config` behaves the same way as every other stack.

# jaskier — the dedicated non-root media/entertainment service account, the
# same identity the *arr and the manga stack write as.
PUID=13000
PGID=13000
