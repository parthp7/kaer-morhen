# Sure stack secrets — real .env lives only at ciri:/data/stacks/sure/.env (chmod 600).
POSTGRES_USER=sure_user
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=<SURE_DB_PASSWORD>
POSTGRES_DB=sure_production
# Generate: openssl rand -hex 64
SECRET_KEY_BASE=<SURE_SECRET_KEY_BASE>
# AI chat/rules via the LOCAL Ollama (configs/ciri/ai, proposal 002) — no API
# costs, no data leaves the LAN. Comment all three out to disable AI entirely.
# The token is only a presence check for Ollama; any non-empty string works.
OPENAI_ACCESS_TOKEN=ollama
OPENAI_URI_BASE=http://<LAN_PREFIX>.150:11434/v1
# REQUIRED whenever OPENAI_URI_BASE is set. Pick per the quality/latency
# trade-off documented in README "Model choice":
#   qwen2.5:7b-instruct ~40 s, 100% GPU (4.8 GB), no thinking  <- current
#   qwen3:8b            thinks, ~1-2 min/reply, partial GPU
#   qwen3:30b-a3b       best comprehension BUT 18 GB on a 6 GB card: runs on
#                       CPU at ~12 tok/s, 311 s for a multi-tool reply
# Anything that thinks REQUIRES the raised timeout below.
# Verify placement with `docker exec ollama ollama ps` -> want 100% GPU.
OPENAI_MODEL=qwen2.5:7b-instruct

# Token budgets (provider/openai.rb). Defaults are 2048/512, tuned for a much
# smaller local model than we run; align them with the AI stack's 8192 context.
LLM_CONTEXT_WINDOW=8192
LLM_MAX_RESPONSE_TOKENS=1024

# Seconds before Sure discards a pending assistant reply. Upstream hardcodes
# 60 s; our mounted initializer makes it configurable. Must exceed the slowest
# real reply (message age spans ALL tool round trips, not one HTTP call) and
# stay under OPENAI_REQUEST_TIMEOUT so a hung call fails first.
LLM_UNDELIVERED_RESPONSE_TIMEOUT=400
OPENAI_REQUEST_TIMEOUT=420
# To use hosted OpenAI instead: set a real sk-... token here and comment out
# OPENAI_URI_BASE + OPENAI_MODEL (Sure then defaults to gpt-4.1).
