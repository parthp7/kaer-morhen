# ai stack secrets — copy to .env (chmod 600) on ciri, never commit the real one.
# Generate each with: openssl rand -hex 32

# Open WebUI session/JWT signing key. Changing it invalidates all sessions.
WEBUI_SECRET_KEY=<WEBUI_SECRET_KEY>

# SearXNG server.secret_key (cookie/CSRF signing).
SEARXNG_SECRET=<SEARXNG_SECRET>
