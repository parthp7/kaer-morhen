# servarr stack secrets/config — copy to .env (chmod 600, VM-only, git-ignored).
#   cp .env.example .env && chmod 600 .env && $EDITOR .env
# Every ${VAR:?} in compose.yaml MUST be set here or the stack refuses to start.

# --- Proton VPN (WireGuard, for gluetun) ---
# In the Proton VPN account portal: Downloads -> WireGuard configuration ->
# create a NEW config with "NAT-PMP (Port Forwarding)" toggled ON and a P2P
# server/router selected. Copy its PrivateKey below and Address into WIREGUARD_ADDRESSES.
PROTON_WG_PRIVATE_KEY=<proton-wireguard-private-key>
WIREGUARD_ADDRESSES=10.2.0.2/32
# Optional: comma-separated country names to pin egress (must have P2P+PF servers).
VPN_COUNTRIES=Netherlands

# --- LinuxServer container ownership ---
# Runs the media writers (qBittorrent + *arr) as the dedicated service account
# `jaskier` (uid/gid 13000, the bard = media). NOT root, and deliberately NOT the
# human `ciri` login user (1000) — a separate id so a compromised download app
# can't touch anything the ciri user owns. Create it on the host once (see README)
# and chown the media tree to it.
PUID=13000
PGID=13000
TZ=Asia/Kolkata
