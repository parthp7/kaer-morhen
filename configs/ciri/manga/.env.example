# manga stack secrets — copy to .env (chmod 600) on ciri, never commit the real one.
# Real values live in the git-ignored secrets.local.yaml.

# Proton WireGuard — a SECOND, DISTINCT config, not servarr's.
# Reusing PROTON_WG_PRIVATE_KEY from the servarr stack puts two live sessions
# on one peer and BOTH tunnels flap — which looks like a manga fault but takes
# your torrents down too. Generate a new WireGuard configuration in the Proton
# dashboard (one of ten device slots) and take both values from that file:
#   PrivateKey = ...   -> MANGA_WG_PRIVATE_KEY
#   Address    = ...   -> MANGA_WG_ADDRESSES   (typically 10.2.0.2/32)
MANGA_WG_PRIVATE_KEY=<MANGA_WG_PRIVATE_KEY>
MANGA_WG_ADDRESSES=<MANGA_WG_ADDRESSES>

# EXIT country, and whether to require Secure Core (double hop).
#
# gluetun ignores the endpoint in the config file you downloaded and picks a
# server from its own list, so "Thailand via Iceland" in the Proton dashboard
# constrains nothing — only these two values decide the routing. From that
# file you need the key and the address, nothing else.
#
# SERVER_COUNTRIES names the EXIT. The entry hop (CH/IS/SE) is Proton's
# choice and is not filterable — it appears only in the server name, e.g.
# "CH-TH#2" = enter Switzerland, exit Thailand. Switzerland itself has zero
# secure-core exits, which is the tell: it is an entry country only.
#
# Mind the pool size. WireGuard secure-core servers per exit, as of
# 2026-09-20: United States 77, Netherlands 19, Japan 4, Hong Kong 3,
# Singapore 2, Thailand 2. A two-server pool means both being unavailable
# leaves no tunnel and therefore (correctly) no Suwayomi. Latency matters too:
# from India, an exit in Thailand still routes via Europe first.
#
# Set MANGA_SECURE_CORE=off for ordinary single-hop servers. Leave it on and
# SERVER_COUNTRIES will match ONLY secure-core servers — without the flag it
# would also match the single-hop servers in the same country and gluetun
# could silently pick one.
MANGA_VPN_COUNTRIES=Netherlands
MANGA_SECURE_CORE=on

# Suwayomi WebUI basic auth (AUTH_MODE=basic_auth). Its own gate — Caddy is a
# plain proxy, and auth at the proxy could never cover the bare port on .150.
SUWAYOMI_USER=<SUWAYOMI_USER>
SUWAYOMI_PASSWORD=<SUWAYOMI_PASSWORD>
