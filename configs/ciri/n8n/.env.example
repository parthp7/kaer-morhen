# Copy to .env on ciri, fill in, chmod 600. Never commit the real file.
# Real values belong in secrets.local.yaml.
#
# <LAN_PREFIX> below is a placeholder for the first three octets of the LAN.
# Replace it in the real .env — compose does not expand it (proposal 008
# Appendix B learned this the hard way).

# n8n credential-store key. Generate once: openssl rand -hex 32
# Losing it loses every stored credential (IMAP password, Sure API key).
N8N_ENCRYPTION_KEY=<N8N_ENCRYPTION_KEY>

# Sure, reached by host IP: sure_net and n8n_net are separate bridges.
SURE_URL=http://<LAN_PREFIX>.150:3000
# From `GET /api/v1/accounts` after the API key exists (runbook Phase B2).
SURE_ACCOUNT_ID_SAVINGS=<SURE_ACCOUNT_ID_SAVINGS>
SURE_ACCOUNT_ID_CC=<SURE_ACCOUNT_ID_CC>
# Optional: id of the `auto:sms` tag (Settings -> Tags). Blank = no tag.
SURE_TAG_ID_AUTO_SMS=

# Last four digits of the HDFC savings account and credit card. The parser
# routes each SMS to a Sure account by matching these; an SMS naming an
# unknown instrument is rejected to ntfy, never guessed.
HDFC_SAVINGS_LAST4=<HDFC_SAVINGS_LAST4>
HDFC_CC_LAST4=<HDFC_CC_LAST4>

# Ollama fallback extractor (configs/ciri/ai). Host IP, same reason as Sure.
OLLAMA_URL=http://<LAN_PREFIX>.150:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Uptime-Kuma push monitor `n8n-hdfc-ingest` (uptime-kuma.md). Bare base URL,
# no ?status= query — the workflow appends its own. By IP, never by name.
KUMA_PUSH_URL=http://<LAN_PREFIX>.104:3001/api/push/<KUMA_PUSH_TOKEN_N8N_HDFC>
# The lab-wide ntfy.sh topic (monitoring.md). Unparsed/rejected alerts and the
# daily digest land here.
NTFY_TOPIC=<NTFY_TOPIC>

# NOT here, by design: the relay mailbox address + app password and the Sure
# API key are entered in the n8n UI as credentials (encrypted with the key
# above). They are recorded in secrets.local.yaml as RELAY_MAILBOX,
# RELAY_MAILBOX_APP_PASSWORD and SURE_API_KEY_N8N.
