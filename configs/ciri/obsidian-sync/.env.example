# obsidian-sync secrets — the real .env lives ONLY at
# ciri:/data/stacks/obsidian-sync/.env (chmod 600). Never commit it.

# CouchDB server admin. Also the credential Obsidian LiveSync authenticates
# with, and the one the Uptime-Kuma monitor will need (follow-up).
COUCHDB_USER=<COUCHDB_ADMIN_USER>

# Generate: openssl rand -hex 24
# Avoid shell-special characters — this value goes into a URL in the Obsidian
# plugin config, so hex keeps it copy-paste safe.
COUCHDB_PASSWORD=<COUCHDB_ADMIN_PASSWORD>

# Generate: openssl rand -hex 32
# Signs session cookies. Set once and keep it — changing it logs out every
# live replication.
COUCHDB_SECRET=<COUCHDB_SESSION_SECRET>
