# Mirror of 202:/etc/caddy/cloudflare.env — real file is chmod 600 in the LXC.
# Loaded into caddy.service via the drop-in at
# /etc/systemd/system/caddy.service.d/10-env.conf.
#
# Cloudflare API token, scoped as narrowly as DNS-01 allows:
#   Permissions:     Zone -> DNS -> Edit
#   Zone Resources:  Include -> Specific zone -> kaermorhen.fyi
# Nothing broader. This token can only write DNS records for one zone.
CF_API_TOKEN=<CF_API_TOKEN>
